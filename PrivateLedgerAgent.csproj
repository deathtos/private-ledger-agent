<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrivateLedgerAgent</RootNamespace>
    <AssemblyName>ledger-agent</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- No telemetry-bearing or third-party packages: the only network call is to your Foundry endpoint. -->
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="category-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\**\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
