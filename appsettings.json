{
  "Foundry": {
    // Resource endpoint (not a /api/projects/ Agent Service URL).
    // e.g. https://my-resource.openai.azure.com  or  https://my-resource.services.ai.azure.com
    "Endpoint": "",
    "Deployment": "gpt-4.1",
    // AzureOpenAI   -> {endpoint}/openai/deployments/{Deployment}/chat/completions
    // OpenAIv1      -> {endpoint}/openai/v1/chat/completions        (model = Deployment)
    // FoundryModels -> {endpoint}/models/chat/completions           (non-OpenAI Foundry models, model = Deployment)
    "ApiStyle": "AzureOpenAI",
    "ApiVersion": null,
    // ApiKey: key read from the env var below (never from this file). AzureCli: Entra ID token from `az login`.
    "Auth": "ApiKey",
    "ApiKeyEnvVar": "FOUNDRY_API_KEY",
    // Set Temperature to null for reasoning models (o-series / gpt-5) that reject it.
    "Temperature": 0,
    "Seed": 42,
    "MaxToolRounds": 8,
    "MaxVerificationRetries": 2,
    "TimeoutSeconds": 90
  },
  "Data": {
    "Paths": [ "data" ],
    "CategoryRulesPath": "category-rules.json",
    "AsOfDate": "today",
    "AmountSign": "NegativeIsOutflow",
    "CurrencySymbol": "$",
    "ExcludeFromSpendingAndIncome": [ "Transfer", "Credit Card Payment" ]
  },
  "Privacy": {
    "ShareTransactionDetailsWithModel": true,
    "MaxRowsToModel": 50,
    "MaxRefIdsToModel": 200,
    "MaskAccountNumbers": true,
    "RequireHttps": true
  }
}
